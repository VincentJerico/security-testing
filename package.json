{
  "name": "security-testing",
  "version": "0.1.0",
  "description": "Defensive security checks a QA team can run in CI, against a local OWASP Juice Shop.",
  "type": "module",
  "scripts": {
    "app:start": "docker compose up -d --wait",
    "app:stop": "docker compose down",
    "test": "playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "security-testing",
    "owasp",
    "playwright",
    "qa",
    "test-automation"
  ],
  "author": "Vincent Jerico",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
